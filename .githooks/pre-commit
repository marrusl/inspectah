#!/usr/bin/env bash
#
# inspectah pre-commit hook: sensitive-tarball check, then fmt, clippy and
# the workspace tests on the content being committed.
#
# USAGE:
#   pre-commit            git calls it with no argument before each commit
#   pre-commit --head     gate the paths HEAD changed instead of the staged
#                         ones, for `git rebase --exec '.githooks/pre-commit --head'`.
#                         For a merge that is every path it changed against
#                         any parent.
#
# ORDER:
#   1. Unset INSPECTAH_SKIP_UI, so rust-embed never embeds a stale
#      crates/web/ui/dist/. Setting it has no effect on this hook.
#   2. Gate 0: scripts/check-sensitive-tarballs.sh --staged (--tracked with
#      --head). It runs before the fast path, so a fixture-only commit is
#      always checked.
#   3. Load .githooks/docs-only-paths from the index being committed
#      (from HEAD with --head), so the list being committed is the list
#      applied. One anchored ERE per line; blank lines and lines starting
#      with # are ignored; the rest are joined with |. A missing or
#      unreadable list refuses the commit.
#   4. Fast path: if every changed path matches the list (deletions and both
#      sides of a rename count), print the docs-only line and pass. An empty
#      commit is docs-only. A docs-only commit is never refused for other
#      files, so docs writers are not blocked by a code writer's work.
#   5. Refuse while any path that fails the list differs from the index
#      being committed: an unstaged edit, an untracked file, or an ignored
#      Rust source or Cargo.toml under crates/, which the gates would
#      compile but the commit would leave out. With --head, also refuse
#      while the index differs from HEAD, since the gates must test HEAD.
#      Then record the index's tree.
#   6. fmt, clippy and test, each with its output in a file and one line
#      printed per gate; a failed gate prints its file.
#   7. The same refuse check again, and refuse if the index's tree changed
#      while the gates ran.
#
# The gates run on the working tree. Steps 5 and 7 are what make that a test
# of the commit: the hook refuses whenever the tested tree could differ from
# the index being committed. git sets GIT_INDEX_FILE for `commit --only` and
# `commit -a`, and every git command here reads it, so the comparison is
# against the index that becomes the commit, not the real one. An ignored
# file outside crates/**/*.rs and crates/**/Cargo.toml is not checked.
#
# Paths are listed with core.quotePath off, so a non-ASCII name such as
# docs/café.md is matched as written. A name git must still quote (one
# holding a double quote, a backslash or a control character) keeps its
# quotes, fails the list, and so is gated or refused, never exempt.
#
# EXIT: 0 passed or skipped; 1 for everything else: a refusal, a failed
# gate, a usage error, and any non-zero status from gate 0's helper (which
# exits 1, 2 for unreadable input, or 64 for usage or a missing jq).
#
# INSTALL (once per clone):
#   git config core.hooksPath .githooks
#
# BYPASS (last resort):
#   git commit --no-verify
#
# Written for bash 3.2 (macOS /bin/bash): no mapfile, no associative arrays.

set -euo pipefail

DOCS_ONLY_FILE=.githooks/docs-only-paths
# Ignored files that are still build inputs. A *.rs pattern covers build.rs.
IGNORED_INPUTS=(':(glob)crates/**/*.rs' ':(glob)crates/**/Cargo.toml')
CLIPPY_GATE=(cargo clippy --workspace --all-targets -- -D clippy::all)

GATE_DIR=
cleanup() {
    local rc=$?
    if [ -n "$GATE_DIR" ]; then
        rm -rf "$GATE_DIR"
    fi
    # Every failure exits 1, including one set -e raised.
    if [ "$rc" -ne 0 ]; then
        exit 1
    fi
}
trap cleanup EXIT

refuse() {
    echo "pre-commit: commit refused: $1" >&2
    exit 1
}

# git_paths <git arguments...>: git with core.quotePath off, for every
# command whose path list is matched against the docs-only list.
git_paths() {
    git -c core.quotePath=false "$@"
}

mode=staged
case $# in
    0) ;;
    1)
        case "$1" in
            --head) mode=head ;;
            *)
                echo "pre-commit: usage: pre-commit [--head]" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo "pre-commit: usage: pre-commit [--head]" >&2
        exit 1
        ;;
esac

unset INSPECTAH_SKIP_UI
cd "$(git rev-parse --show-toplevel)"

# --- gate 0: no preserve-mode inspectah output in tarballs ---

if [ "$mode" = head ]; then
    tarball_mode=--tracked
else
    tarball_mode=--staged
fi
if scripts/check-sensitive-tarballs.sh "$tarball_mode"; then
    :
else
    rc=$?
    refuse "sensitive-tarball check failed (exit $rc)"
fi

# --- the docs-only list, as committed ---

# load_docs_only: set DOCS_ONLY_RE from the list in the index (HEAD with
# --head). Fails if the list is missing or holds no pattern.
load_docs_only() {
    local raw line re=
    if [ "$mode" = head ]; then
        raw=$(git show "HEAD:$DOCS_ONLY_FILE" 2>/dev/null) || return 1
    else
        raw=$(git show ":$DOCS_ONLY_FILE" 2>/dev/null) || return 1
    fi
    while IFS= read -r line; do
        case "$line" in '' | '#'*) continue ;; esac
        re="${re:+$re|}$line"
    done <<<"$raw"
    [ -n "$re" ] || return 1
    DOCS_ONLY_RE=$re
}

if ! load_docs_only; then
    if [ "$mode" = head ]; then
        refuse "cannot read $DOCS_ONLY_FILE from HEAD"
    fi
    refuse "cannot read $DOCS_ONLY_FILE from the index"
fi

# non_docs_paths <newline-separated list>: print the paths that fail the
# list. A here-string, not a pipe: under pipefail a producer killed by
# SIGPIPE would read as a match. grep exits 1 when it prints nothing, which
# here means every path is docs-only.
non_docs_paths() {
    local rc=0
    grep -vE -e "$DOCS_ONLY_RE" -e '^$' <<<"$1" || rc=$?
    [ "$rc" -le 1 ]
}

# --- fast path: a docs-only commit skips everything below ---

if [ "$mode" = head ]; then
    # -m: without it diff-tree prints nothing for a merge, which would read
    # as docs-only. With it a merge lists its changes against every parent.
    changed=$(git_paths diff-tree -m -r --no-commit-id --name-only --no-renames --root HEAD)
else
    changed=$(git_paths diff --cached --name-only --no-renames)
fi
gated=$(non_docs_paths "$changed")
if [ -z "$gated" ]; then
    echo "pre-commit: docs-only, cargo gates skipped"
    exit 0
fi

# --- refuse check ---

# refuse_if_dirty <first|second>: refuse while a path that fails the list is
# edited and unstaged, untracked and not ignored, or ignored and one of
# IGNORED_INPUTS. Every git command reads GIT_INDEX_FILE, so they compare
# against the index being committed.
refuse_if_dirty() {
    local when unstaged untracked ignored dirty
    if [ "$1" = first ]; then
        when="before the gates ran"
    else
        when="after the gates ran"
    fi
    unstaged=$(git_paths diff --name-only --no-renames)
    untracked=$(git_paths ls-files --others --exclude-standard)
    ignored=$(git_paths ls-files --others --ignored --exclude-standard -- "${IGNORED_INPUTS[@]}")
    dirty=$(non_docs_paths "$unstaged
$untracked
$ignored")
    if [ -n "$dirty" ]; then
        refuse "these paths differ from the commit $when, so the gates would not test it:
$(sed 's/^/    /' <<<"$dirty")
commit it, delete it, or ignore it (an ignored Rust source or Cargo.toml under
crates/ is still compiled: commit it or delete it); docs-only paths are exempt"
    fi
}

# In head mode the commit under test is HEAD, so a staged change outside the
# list would be tested in its place.
if [ "$mode" = head ]; then
    staged=$(git_paths diff --cached --name-only --no-renames HEAD)
    staged=$(non_docs_paths "$staged")
    if [ -n "$staged" ]; then
        refuse "the index differs from HEAD in these paths, so the gates would not test HEAD:
$(sed 's/^/    /' <<<"$staged")
unstage them or commit them first; docs-only paths are exempt"
    fi
fi

refuse_if_dirty first
tree_before=$(git write-tree)

# --- gates: fmt, clippy, test ---

GATE_DIR=$(mktemp -d)

banner() {
    case "$1" in
        fmt)
            cat <<'EOF'

    !! COMMIT BLOCKED — formatting issues found !!

    Run `cargo fmt` to fix, then re-stage and retry your commit.

    Bypass (last resort): git commit --no-verify

EOF
            ;;
        clippy)
            cat <<'EOF'

    !! COMMIT BLOCKED — clippy warnings found !!

    Fix the warnings above, then retry your commit.
    Clippy clean is non-negotiable (see CLAUDE.md).

    Bypass (last resort): git commit --no-verify

EOF
            ;;
        test)
            cat <<'EOF'

    !! COMMIT BLOCKED — test suite failed !!

    Fix the failing tests above, then retry your commit.
    A red suite is never acceptable to skip past (see CLAUDE.md).

    If a pre-existing test is failing, fix it if trivial or quarantine
    it with #[ignore] and a // TODO(green-suite): <reason> comment.

    Bypass (last resort): git commit --no-verify

EOF
            ;;
    esac
}

# run_gate <name> <command...>: run the command with its output in a file,
# print one line with the elapsed time, and on failure print the file and
# the gate's banner and exit 1.
run_gate() {
    local name=$1 log start rc=0
    shift
    log="$GATE_DIR/$name.log"
    start=$SECONDS
    "$@" >"$log" 2>&1 || rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "pre-commit: $name ok ($((SECONDS - start)) s)"
        return 0
    fi
    echo "pre-commit: $name FAILED ($((SECONDS - start)) s)"
    cat "$log"
    banner "$name"
    exit 1
}

run_gate fmt cargo fmt --check
# -D, not -W: -W exits 0 however many warnings it prints. --all-targets is
# equally load-bearing: without it clippy checks lib and bin only, and every
# warning this tree has ever carried lived in a test target.
run_gate clippy "${CLIPPY_GATE[@]}"
run_gate test cargo test --workspace

# --- refuse check, second pass ---

refuse_if_dirty second
if [ "$(git write-tree)" != "$tree_before" ]; then
    refuse "the index changed while the gate ran"
fi

echo "pre-commit: all checks passed."
