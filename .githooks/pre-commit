#!/usr/bin/env bash
#
# inspectah pre-commit hook — green-suite + clippy + fmt gate
#
# Blocks commits unless cargo fmt, cargo clippy, and cargo test all pass.
# Skips the cargo gates when no Rust/Cargo files are in the changeset.
# Always checks staged tarballs for preserved sensitive content first.
#
# INSTALL (once per clone):
#   git config core.hooksPath .githooks
#
# BYPASS (last resort):
#   git commit --no-verify

set -euo pipefail

# --- gate 0: no preserve-mode inspectah output in staged tarballs ---
#
# Runs before the fast-path on purpose: a fixture-only commit stages no Rust
# file, and the fast-path below would let it through unchecked. Reads the
# staged blobs, so a clean working-tree copy cannot mask a staged one.

"$(git rev-parse --show-toplevel)/scripts/check-sensitive-tarballs.sh" --staged

# --- fast-path: skip when no Rust-relevant files changed ---

rust_relevant() {
    # Staged files that could affect compilation or test outcomes.
    # .rs sources, Cargo manifests, build scripts, lockfile.
    # A here-string, not a pipe: under pipefail, git dies on SIGPIPE when
    # grep -q exits on an early match in a long list, and the pipeline's
    # failure would read as "no Rust change" and skip every gate below.
    local staged
    staged=$(git diff --cached --name-only --diff-filter=ACMR)
    grep -qE '\.(rs)$|Cargo\.(toml|lock)$|build\.rs$' <<<"$staged"
}

if ! rust_relevant; then
    exit 0
fi

# --- gate 1: cargo fmt (fast, catches formatting drift) ---

echo "pre-commit: running cargo fmt --check..."
if ! cargo fmt --check 2>&1; then
    cat <<'EOF'

    !! COMMIT BLOCKED — formatting issues found !!

    Run `cargo fmt` to fix, then re-stage and retry your commit.

    Bypass (last resort): git commit --no-verify

EOF
    exit 1
fi

# --- gate 2: clippy (warnings are errors) ---
#
# -D, not -W: -W exits 0 however many warnings it prints, so this gate
# tested an exit code that could not be non-zero and never blocked a commit.
# --all-targets is equally load-bearing: without it clippy checks lib and bin
# only, and every warning this tree has ever carried lived in a test target.

echo "pre-commit: running cargo clippy..."
if ! cargo clippy --workspace --all-targets -- -D clippy::all 2>&1; then
    cat <<'EOF'

    !! COMMIT BLOCKED — clippy warnings found !!

    Fix the warnings above, then retry your commit.
    Clippy clean is non-negotiable (see CLAUDE.md).

    Bypass (last resort): git commit --no-verify

EOF
    exit 1
fi

# --- gate 3: cargo test (full workspace) ---

echo "pre-commit: running cargo test..."
if ! cargo test --workspace 2>&1; then
    cat <<'EOF'

    !! COMMIT BLOCKED — test suite failed !!

    Fix the failing tests above, then retry your commit.
    A red suite is never acceptable to skip past (see CLAUDE.md).

    If a pre-existing test is failing, fix it if trivial or quarantine
    it with #[ignore] and a // TODO(green-suite): <reason> comment.

    Bypass (last resort): git commit --no-verify

EOF
    exit 1
fi

echo "pre-commit: all checks passed."
